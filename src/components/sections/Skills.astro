---
import SectionHeading from '../SectionHeading.astro';
import skills from '../../data/skills.json';
---

<section id={skills.id} class="border-b border-line px-8 py-20 sm:px-12">
	<SectionHeading tag={skills.tag} icon={skills.icon} heading={skills.heading} />

	<div class="mt-10 space-y-10">
		{
			skills.groups.map((group, gi) => (
				<div>
					<p
						class="text-base font-semibold uppercase tracking-wide text-accent sm:text-lg"
						data-aos="fade-up"
						data-aos-delay={gi * 60}
					>
						{group.label}
					</p>

					{group.label === 'Coding' ? (
						<div class="mt-6 space-y-6">
							{(['core', 'familiar', 'others'] as const).map((level) => {
								const items = group.items.filter((item) => 'level' in item && item.level === level);
								if (!items.length) return null;
								return (
									<div>
										<p class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-widest text-muted">
											<span class="h-2 w-2 rounded-full bg-accent" />
											{level === 'core' ? 'Core' : level === 'familiar' ? 'Familiar' : 'Others'}
										</p>
										{level === 'others' ? (
											<div class="mt-2 flex flex-wrap gap-2">
												{items.map((item, i) => (
													<span
														data-aos="fade-up"
														data-aos-delay={i * 60}
														class="rounded-full border border-accent/40 bg-accent/10 px-3 py-1 text-sm text-ink"
													>
														{item.name}
													</span>
												))}
											</div>
										) : (
											<div class="mt-2 grid gap-4 sm:grid-cols-2">
												{items.map(
													(item, i) =>
														'description' in item && (
															<div
																data-aos="fade-up"
																data-aos-delay={i * 60}
																class="rounded-2xl border border-line bg-panel/40 p-4"
															>
																<p class="text-sm font-semibold text-ink">{item.name}</p>
																<p class="mt-2 text-sm leading-relaxed text-muted">{item.description}</p>
															</div>
														)
												)}
											</div>
										)}
									</div>
								);
							})}
						</div>
					) : group.label === 'AI Tools' ? (
						<div class="mt-6 grid gap-4 sm:grid-cols-2">
							{group.items.map(
								(item, i) =>
									'description' in item && (
										<div
											data-aos="fade-up"
											data-aos-delay={i * 60}
											class="rounded-2xl border border-line bg-panel/40 p-4"
										>
											<p class="text-sm font-semibold text-ink">{item.name}</p>
											<p class="mt-2 text-sm leading-relaxed text-muted">{item.description}</p>
										</div>
									)
							)}
						</div>
					) : (
						<div class="mt-6 flex flex-wrap gap-2">
							{group.items.map((item, i) => (
								<span
									data-aos="fade-up"
									data-aos-delay={i * 60}
									class="rounded-full border border-accent/40 bg-accent/10 px-3 py-1 text-sm text-ink"
								>
									{item.name}
								</span>
							))}
						</div>
					)}
				</div>
			))
		}
	</div>
</section>
